# Required to store calculator leads and leak reviews. Service role key, not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for email delivery. A stored review still succeeds if these are missing.
RESEND_API_KEY=
PRAXORA_FROM_EMAIL=
PRAXORA_NOTIFICATION_EMAIL=

PRAXORA_GA_MEASUREMENT_ID=

# Recommended dedicated salt for rate-limit hashes. If empty, the service role key is used.
RATE_LIMIT_SALT=
