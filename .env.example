# Optional storage. Set both, or leave both empty. Forms still succeed with neither set.
# Service role key, not the anon key. Do not point SUPABASE_URL at a /rest/v1 path.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required to send email. A validated submission still returns HTTP 200 if these are empty.
# Leak-review founder mail also needs PRAXORA_NOTIFICATION_EMAIL.
RESEND_API_KEY=
PRAXORA_FROM_EMAIL=
PRAXORA_NOTIFICATION_EMAIL=

PRAXORA_GA_MEASUREMENT_ID=

# Optional salt for rate-limit hashes. If empty and Supabase is unset, a built-in pepper is used
# and the 5-request / 10-minute limit stays in memory on that instance.
RATE_LIMIT_SALT=
